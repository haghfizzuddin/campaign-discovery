# All keys are OPTIONAL. The pipeline runs without any of them.

# Where the SQLite DB, raw evidence store and editable config live (default: ./data)
# CDISC_HOME=./data

# abuse.ch (URLhaus / ThreatFox / MalwareBazaar) now require a free Auth-Key
# for API lookups. Register at https://auth.abuse.ch/ . The URLhaus CSV feed
# collector works without a key; only host/IOC lookups need it.
# ABUSECH_AUTH_KEY=

# GitHub token raises search rate limits from 10/min to 30/min and enables
# repo content fetches at 5000/hour. Any classic token with public_repo scope.
# GITHUB_TOKEN=

# IntelOwl (self-hosted) for deeper observable enrichment
# INTELOWL_URL=http://localhost
# INTELOWL_API_KEY=

# Claude for cluster interpretation (cdisc interpret CLU-0001)
# ANTHROPIC_API_KEY=
